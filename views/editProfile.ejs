<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Edit Profile</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

<style>
body{
  background: linear-gradient(135deg, #1d976c, #93f9b9);
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  font-family:"Segoe UI", sans-serif;
}

.wrapper{
  background:#fff;
  border-radius:25px;
  overflow:hidden;
  box-shadow:0 15px 40px rgba(0,0,0,0.25);
  max-width:900px;
  width:100%;
}

.left-panel{
  background:linear-gradient(to bottom, #185a9d, #43cea2);
  color:white;
  padding:50px;
  min-height:500px;
}

.left-panel h2{
  font-weight:bold;
}

.right-panel{
  padding:45px;
}

.form-control{
  border-radius:10px;
  padding:12px;
}

.form-label{
  font-weight:600;
}

.btn-success{
  border-radius:10px;
  padding:10px 25px;
}

.cancel-btn{
  border-radius:10px;
  padding:10px 25px;
}

.title{
  color:#28a745;
  font-weight:700;
}
</style>
</head>

<body>
<div class="wrapper row g-0">

  <!-- LEFT PANEL -->
  <div class="col-md-4 left-panel d-flex flex-column justify-content-center text-center">

    <% if(user.role === "ngo"){ %>

      <h2>🏢</h2>
      <h4><%= user.name %></h4>
      <p class="mt-3">
        Update your NGO profile information.
      </p>

      <p>
        Keep your contact details up to date so donors can reach you easily.
      </p>

    <% } else { %>
      <h2>👤</h2>
      <h4><%= user.name %></h4>

      <p class="mt-3">
        Update your personal profile information.
      </p>

      <p>
        Keep your details up to date.
      </p>

    <% } %>

    <p class="mt-4">
      <strong>“Your kindness creates change.”</strong>
    </p>

  </div>


  <!-- RIGHT PANEL -->
  <div class="col-md-8 right-panel">
    <h3 class="title mb-4">Edit Profile</h3>
    <form action="/api/users/edit" method="POST">

      <div class="mb-3">
        <label class="form-label">Name</label>
        <input
          type="text"
          name="name"
          class="form-control"
          value="<%= user.name %>"
          required
        >
      </div>

      <div class="mb-3">
        <label class="form-label">Email</label>
        <input
          type="email"
          name="email"
          class="form-control"
          value="<%= user.email %>"
          required
        >
      </div>


      <!-- NGO CONTACT PERSON -->
      <% if(user.role === "ngo"){ %>
        <div class="mb-3">
          <label class="form-label">Contact Person</label>
          <input
            type="text"
            name="contactPerson"
            class="form-control"
            value="<%= user.contactPerson %>"
            required
          >
        </div>

      <% } %>


      <!-- ROLE -->
      <div class="mb-4">
        <label class="form-label">Account Type</label>
        <input
          type="text"
          class="form-control"
          value="<%= user.role === 'ngo' ? 'NGO' : 'User' %>"
          disabled
        >
      </div>

      <!-- BUTTONS -->
      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">
          <i class="fa fa-save"></i> Save Changes
        </button>

        <a href="/api/users" class="btn btn-outline-secondary cancel-btn">
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>

</body>
</html>

