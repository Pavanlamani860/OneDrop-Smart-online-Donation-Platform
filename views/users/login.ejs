<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Login</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />

    <style>
      body {
        background: linear-gradient(135deg, #1d976c, #93f9b9);
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: "Segoe UI", sans-serif;
      }

      .wrapper {
        background: white;
        border-radius: 25px;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.25);
        max-width: 700px;
        width: 100%;
        padding: 40px;
      }

      .logo {
        text-align: center;
        margin-bottom: 20px;
      }

      .logo h2 {
        color: #198754;
        font-weight: bold;
      }

      .role-card {
        border: 2px solid #ddd;
        border-radius: 10px;
        padding: 12px;
        cursor: pointer;
        transition: 0.3s;
        text-align: center;
      }

      .role-card:hover {
        border-color: #198754;
      }

      .role-card input {
        float: left;
      }

      .role-card i {
        font-size: 22px;
        margin-top: 10px;
        color: #198754;
      }

      .form-control {
        border-radius: 12px;
      }

      .btn-success {
        border-radius: 12px;
        font-size: 18px;
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <div class="logo">
        <h2><i class="fa-solid fa-droplet"></i> OneDrop</h2>
        <h3>Welcome Back!</h3>
        <p class="text-muted">Login to your account</p>
      </div>

      <!-- Flash Messages -->
      <% if (success && success.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= success[0] %>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="alert"
          ></button>
        </div>
        <% } %>
        
        <% if (error && error.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= error[0] %>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="alert"
          ></button>
        </div>
        <% } %>

      <form action="/api/auth/login" method="POST">
        <!-- LOGIN AS -->
        <div class="mb-4">
          <div class="row">
            <div class="col-md-6">
              <label class="role-card w-100">
                <input type="radio" name="role" value="user" checked />
                <i class="fa-solid fa-user"></i>
                <p class="text-muted">Login as User</p>
              </label>
            </div>

            <div class="col-md-6">
              <label class="role-card w-100">
                <input type="radio" name="role" value="ngo" />
                <i class="fa-solid fa-building"></i>
                <p class="text-muted">Login as NGO</p>
              </label>
            </div>
          </div>
        </div>

        <!-- EMAIL -->
        <div class="mb-3">
          <label class="form-label">Email</label>
          <input
            type="email"
            name="email"
            class="form-control"
            placeholder="Enter your email"
            required
          />
        </div>

        <!-- PASSWORD -->

        <div class="mb-4">
          <label class="form-label">Password</label>
          <input
            type="password"
            name="password"
            class="form-control"
            placeholder="Enter your password"
            required
          />
        </div>

        <!-- LOGIN -->

        <button class="btn btn-success w-100">
          <i class="fa fa-lock"></i>
          Login
        </button>
      </form>

      <div class="mt-4 text-center">
        <p>
          Don't have an account?
          <a href="/api/auth/signup">Register here</a>
        </p>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
